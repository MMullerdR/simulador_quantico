# Scripts precisam rodar via bash no WSL/Linux — CRLF quebra o shebang e
# vários trechos do script (heredocs, comparações). Força LF independente
# de core.autocrlf no lado Windows.
*.sh text eol=lf

# Vetores de referencia da migracao (tests/golden): os .f32 sao binarios (um
# float sem byte NUL passaria por texto e seria corrompido pela conversao de fim
# de linha) e os .case/.py precisam ter LF para o leitor em Rust e o Python.
tests/golden/data/**/*.f32 binary
tests/golden/data/**/*.case text eol=lf
tests/golden/data/INDEX.txt text eol=lf
*.py text eol=lf
tests/golden/data/runs.txt text eol=lf
*.mk text eol=lf
